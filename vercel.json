{
  "version": 2,
  "builds": [
    { "src": "Backend/index.js", "use": "@vercel/node" },
    { "src": "client/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "rewrites": [
    { "source": "/api/v1/edi/(.*)", "destination": "Backend/index.js" },
    { "source": "/(.*)", "destination": "client/$1" }
  ]
}